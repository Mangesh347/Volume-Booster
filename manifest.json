{
  "manifest_version": 3,
  "name": "XCoda — Clear Audio Booster",
  "version": "2.11.8",
  "description": "Boost Chrome audio to 300% free. Pro unlocks 600%, premium sound scenes, and Music Ad Block.",
  "permissions": ["scripting", "storage", "tabs", "identity", "alarms"],
  "host_permissions": [
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": [
      "https://volume-booster-ten.vercel.app/*"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "XCoda",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["music-sites.js", "vb-adblock.js", "injected.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
