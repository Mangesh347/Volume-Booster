{
  "manifest_version": 3,
  "name": "XCoda — Clear Audio Booster",
  "version": "2.11.11",
  "description": "Boost Chrome audio up to 300% with XCoda. Pro adds 600% boost, sound scenes, and Music Ad Block.",
  "permissions": ["storage", "identity", "alarms"],
  "host_permissions": [
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": [
      "https://volume-booster-ten.vercel.app/*"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "XCoda",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["https://accounts.google.com/*"],
      "js": ["music-sites.js", "vb-adblock.js", "injected.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
