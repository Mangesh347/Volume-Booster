SITE_URL=https://volume-booster-ten.vercel.app

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
# Optional but recommended: verify the capture was paid to this exact account.
PAYPAL_MERCHANT_ID=
PAYPAL_RECEIVER_EMAIL=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

INR_USD_RATE=95.12

# Supabase (Auth + Pro/Free)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional extra salt for hashed API rate-limit buckets.
RATE_LIMIT_SECRET=

# Google OAuth (same Client ID enabled in Supabase Auth → Google)
GOOGLE_CLIENT_ID=

# After loading the unpacked extension, copy its ID from chrome://extensions
# and add BOTH of these (with your real ID) as Authorized redirect URIs:
#   Google Cloud Console → Credentials → Web client
#   Supabase → Authentication → URL Configuration → Redirect URLs
#     https://<EXTENSION_ID>.chromiumapp.org/
#     https://<EXTENSION_ID>.chromiumapp.org

ALLOW_SIMULATED_PAYMENTS=false
# Set true only in an isolated local/sandbox environment. Production always rejects simulations.

# Signs VB1.* licenses after payment (server-only)
ENTITLEMENT_SECRET=
